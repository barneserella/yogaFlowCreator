<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yoga Poses</title>
</head>
<body>
    <h1>Yoga Poses</h1>

    <% poses.forEach(pose => { %> 
    <li>
    <div class="card" style="width: 18rem;">
        <img src="..." class="card-img-top" alt="...">
        <div class="card-body">
        <h5 class="card-title"><% pose.english_name %>></h5>
        <p class="card-text"><% pose.pose_description %></p>
        <a href="#" class="btn btn-primary">Add To Flow</a>
        </div>
    </div>
    </li>
    <% }) %>
</body>
</html>